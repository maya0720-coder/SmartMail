# 업무 처리 관리 현황 - 환경 설정 예제
# 이 파일에는 키 이름과 placeholder만 둔다. 실제 값은 .env(추적 제외)에 넣는다.
# 모든 키는 SMARTMAIL_ 접두사를 쓴다. 정의되지 않은 키가 있으면 시작을 거부한다.
# ID·암호 등 자격증명은 환경 변수·URL로도 받지 않는다(로그인 창에서 1회 입력 후 즉시 폐기).

# 로컬 서버 (127.0.0.1에만 바인딩)
SMARTMAIL_APP_HOST=127.0.0.1
SMARTMAIL_APP_PORT=8080
# 로컬 개발 전용: 오류 응답에 예외 종류 이름 표시(기본 false)
SMARTMAIL_DEBUG=false

# 외부 시스템 주소 (확인 필요). https만 허용, 사용자 정보·쿼리 문자열 불가
SMARTMAIL_WIKI_BASE_URL=https://docs.golfzon.company/spaces/IE/pages/369684/ERP+%EC%A3%BC%EA%B0%84%EB%B3%B4%EA%B3%A0
SMARTMAIL_GKNOWLEDGE_BASE_URL=https://gk.golfzon.company/
SMARTMAIL_AIGROUND_BASE_URL=https://ai-ground.golfzon.company/
SMARTMAIL_GROUPWARE_MAIL_BASE_URL=https://office.golfzon.corp/

# 로그 폴더(기본: 프로젝트 logs/)
SMARTMAIL_LOG_DIR=logs

# 로그인·세션: 유휴 시간(분), 사이트 로그인 화면을 직접 띄울 사이트(2단계 인증·SSO, 확인 후 지정)
SMARTMAIL_SESSION_IDLE_MINUTES=30
# 앱 실행 중 로그인 유지(true: 유휴 만료 없음, 로그아웃·앱 종료·사이트 쪽 만료 때만 끝남)
SMARTMAIL_SESSION_KEEP_WHILE_RUNNING=true
# 연결 유지 점검 주기(분, 0=끔): 사이트 쪽에서 로그인이 끝났는지 확인
SMARTMAIL_SESSION_KEEPALIVE_MINUTES=15
# 사이트 이름을 쉼표로 구분: wiki, g-knowledge, ai-ground, groupware
SMARTMAIL_BROWSER_LOGIN_SITES=g-knowledge,ai-ground

# 내부(회사) 메일 도메인(쉼표 구분). 비우면 회사 계정 도메인을 쓴다. 다른 도메인은 외부 회사로 표시
SMARTMAIL_INTERNAL_DOMAINS=

# 메일 수집 경로: auto(클래식 아웃룩 감지 후 실패 시 그룹웨어) / outlook / groupware
SMARTMAIL_MAIL_SOURCE=auto
# 제외 규칙 파일 경로(비우면 기본 규칙 사용)
SMARTMAIL_MAIL_RULES_FILE=
# 처음 실행 시 자동 수집 기간(일, 1~366). 이후에는 마지막 수집 시각부터 새 메일만 읽는다
SMARTMAIL_MAIL_INITIAL_DAYS=30
# 자동 새로고침 간격(분, 0~1440). 0이면 앱 시작 시 1회만 자동 수집
SMARTMAIL_MAIL_SYNC_MINUTES=10

# 지식 AI 어댑터: gllm(AI-Ground g-llm, 규격 확인 필요) / fake(가짜 응답, 외부 전송 없음)
SMARTMAIL_AI_ADAPTER=gllm

# 데모 모드: 실제 사이트 대신 가짜 연동과 가상 데이터로 실행(true/false)
SMARTMAIL_DEMO_MODE=false
# 데모 모드에서 가상 과거 해결 사례·가상 G-Knowledge 문서를 미리 넣기(true/false, 데모 모드에서만)
SMARTMAIL_DEMO_SEED=true

# 보관·지표·타임아웃
SMARTMAIL_RETENTION_DAYS=7
SMARTMAIL_METRICS_LEDGER_KEEP=false
# 기한 준수율 목표(0~1, IE팀 확정 전 예시값)
SMARTMAIL_METRICS_DUE_TARGET=0.9
# 로컬 DB 파일 위치(기본: 프로젝트 data/smartmail.db)
SMARTMAIL_DB_PATH=data/smartmail.db
# 담당자 표시명(지표 원장·G-Knowledge R&R). 별칭 가능
SMARTMAIL_USER_DISPLAY_NAME=본인
# 주간보고 마감 알림: 'WED 15:00'처럼 요일(MON~SUN)과 시각. 비우면 끔. 이번 주 게시 기록이 없으면 화면 위에 배너
SMARTMAIL_WEEKLY_REMIND_AT=
# 내가 보낸 질문에 회신이 없을 때 '팔로업 필요'로 보기까지 근무일 수(1~20, 주말·공휴일 제외). 메일 발송 기능은 없습니다
SMARTMAIL_FOLLOWUP_BUSINESS_DAYS=2
SMARTMAIL_HTTP_TIMEOUT_SECONDS=30
# AI-Ground 답변(스트리밍) 대기 상한(초)
SMARTMAIL_AI_TIMEOUT_SECONDS=90
# 요청 요약 동시 처리 묶음 수(1~10, 묶음당 최대 4건). AI-Ground 호출 상한(10분당 20회)은 그대로 지켜집니다
SMARTMAIL_SUMMARY_CONCURRENCY=5
