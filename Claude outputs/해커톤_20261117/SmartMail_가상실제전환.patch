+def test_data_mode_api_switches_container(tmp_path: Path) -> None:
+    real = make_container(tmp_path, FixedClock(NOW), demo_mode=False)
+    modes = DataModes(real, build_demo_container(real))
+    from fastapi.testclient import TestClient
+
+    from app.factory import create_app
+    from app.web_security import LOOPBACK_CLIENTS
+    from fixtures.app_factory import BASE_URL
+
+    app = create_app(
+        real,
+        run_background_jobs=False,
+        trusted_clients=(*LOOPBACK_CLIENTS, "testclient"),
+        modes=modes,
+    )
+    with TestClient(app, base_url=BASE_URL, raise_server_exceptions=False) as client:
+        client.headers.update({"X-CSRF-Token": real.csrf_token})
+        assert client.get("/api/data-mode").json() == {
+            "current": "real",
+            "available": ["real", "demo"],
+        }
+        assert client.get("/api/tasks").json() == []
+        assert client.post("/api/data-mode", json={"mode": "demo"}).json()["current"] == "demo"
+        assert len(client.get("/api/tasks").json()) > 40
+        page = client.get("/")
+        assert "가상 데이터 화면" in page.text and 'data-mode="real"' in page.text
+        assert client.post("/api/data-mode", json={"mode": "other"}).status_code == 422
+        # CSRF 토큰 없이 전환 불가
+        assert (
+            client.post(
+                "/api/data-mode", json={"mode": "real"}, headers={"X-CSRF-Token": "x"}
+            ).status_code
+            == 403
+        )
+        assert client.post("/api/data-mode", json={"mode": "real"}).json()["current"] == "real"
+        assert client.get("/api/tasks").json() == []
+
