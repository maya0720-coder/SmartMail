@@ -35,3 +35,23 @@
     if value.tzinfo is None:
         raise ValueError("시간대가 있는 시각이 필요합니다")
     return value
+
+
+class OffsetClock:
+    """시스템 시각 + 조정값. 시연 데이터를 과거 시점으로 처리해 넣을 때만 쓴다(결정기록 0042).
+
+    `at(moment)`으로 잠시 그 시각처럼 동작하고, `reset()`으로 실제 시각으로 돌아간다.
+    """
+
+    def __init__(self) -> None:
+        self._offset = timedelta(0)
+
+    def now(self) -> datetime:
+        return datetime.now(UTC) + self._offset
+
+    def at(self, moment: datetime) -> None:
+        require_aware(moment)
+        self._offset = moment - datetime.now(UTC)
+
+    def reset(self) -> None:
+        self._offset = timedelta(0)
diff -ruN a/src/integrations/ai/demo_sales_ai.py b/src/integrations/ai/demo_sales_ai.py
--- a/src/integrations/ai/demo_sales_ai.py	1970-01-01 09:00:00.000000000 +0900
+++ b/src/integrations/ai/demo_sales_ai.py	2026-11-17 08:35:34.188075577 +0900
@@ -0,0 +1,28 @@
+"""가상(영업팀) 화면 전용 가짜 AI(결정기록 0042). 외부 전송 없음.
+
+가짜 AI의 요청 요약에 시연용 요약 제목(`collectors.demo_sales_titles.SUMMARY_TITLES`)을 씌운다.
+메일 제목이 표에 없으면 기본 가짜 AI 결과를 그대로 쓴다.
+"""
+
+from __future__ import annotations
+
+from dataclasses import replace
+
+from collectors.demo_sales_titles import SUMMARY_TITLES
+from domain.ai import RequestDigest
+from integrations.ai.fake import _SUBJECT, FakeKnowledgeAI
+
+
+class SalesDemoAI(FakeKnowledgeAI):
+    def _digest(self, text: str) -> RequestDigest | None:
+        digest = super()._digest(text)
+        match = _SUBJECT.search(text)
+        if digest is None or match is None:
+            return digest
+        subject = match.group(1).strip()
+        if len(subject) < 6:
+            return digest
+        for raw, title in SUMMARY_TITLES.items():
+            if raw in subject or subject in raw:
+                return replace(digest, title=title[:40])
+        return digest
