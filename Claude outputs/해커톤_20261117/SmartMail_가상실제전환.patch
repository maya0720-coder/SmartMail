+
+def test_demo_container_is_isolated_and_seeded(tmp_path: Path) -> None:
+    real = make_container(tmp_path, FixedClock(NOW), demo_mode=False)
+    demo = build_demo_container(real)
+    assert demo.db is not real.db
+    assert demo.csrf_token == real.csrf_token
+    tasks = demo.tasks.list_tasks()
+    assert len(tasks) > 40
+    statuses = {t.status for t in tasks}
+    assert {TaskStatus.SUGGESTED, TaskStatus.DONE, TaskStatus.IN_PROGRESS} <= statuses
+    done = [t for t in tasks if t.status is TaskStatus.DONE]
+    assert all(t.closed_at is not None and t.closed_at <= datetime.now(UTC) for t in done)
+    assert any(t.gk_registered for t in done)
+    assert len(demo.ledger.list_entries()) == len(done)
+    assert real.tasks.list_tasks() == []  # 실제 DB에는 아무것도 들어가지 않음
+    assert isinstance(demo.clock, OffsetClock)
+
